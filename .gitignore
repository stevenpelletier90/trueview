# Dependencies
node_modules/
vendor/

# Linter / formatter caches
.phpcs-cache
.stylelintcache
.eslintcache

# Environment
.env
.env.local
.env.*.local

# IDE — share project-level VS Code config, keep the rest local
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary / scratch
*.tmp
*.bak
*.backup
tmp/

# Dev-only static preview harness (render theme templates outside WordPress)
_preview*.html
_preview_render.php

# Playwright MCP page snapshots (transient dev artifacts)
.playwright-mcp/

# Build artifacts (theme zip for upload)
*.zip

# Claude Code — shared config is tracked (settings.json, agents/); local state is not.
# Verified 2026-07-16: settings.local.json (personal overrides) and
# scheduled_tasks.lock (runtime lock: sessionId/pid) are the only local artifacts
# Claude Code actually writes into a project's .claude/. Session todos live in
# ~/.claude/projects/<path>/<session-id>/, NOT here — a `.claude/todos/` rule was
# ignoring a path that has never existed in any of these repos.
.claude/settings.local.json
.claude/scheduled_tasks.lock
