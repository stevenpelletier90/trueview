# Dependencies
node_modules/
vendor/

# Linter / formatter caches
.phpcs-cache
.stylelintcache
.eslintcache

# Environment
.env
.env.local
.env.*.local

# IDE — share project-level VS Code config, keep the rest local
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary / scratch
*.tmp
*.bak
*.backup
tmp/

# Dev-only static preview harness (render theme templates outside WordPress)
_preview*.html
_preview_render.php

# Playwright MCP page snapshots (transient dev artifacts)
.playwright-mcp/

# Build artifacts (theme zip for upload)
*.zip

# Claude Code — shared config is tracked (settings.json, agents/); local state is not.
# Verified 2026-07-16 against real artifacts, not a template:
#   settings.local.json  — personal overrides
#   scheduled_tasks.lock — runtime lock (sessionId/pid)
#   worktrees/           — where EnterWorktree puts isolated worktrees. Untracked
#                          without this, so a stray `git add -A` could commit a
#                          whole worktree. Verified: it was NOT ignored before.
# Session todos are NOT here — they live in ~/.claude/projects/<path>/<session-id>/.
# A `.claude/todos/` rule was ignoring a path that has never existed in any repo.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
